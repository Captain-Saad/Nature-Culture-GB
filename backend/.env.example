# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection used by Prisma. Live database is on Supabase --
# from the project's dashboard: Project Settings > Database > Connection
# string > URI. Use the "Transaction pooler" / "Session pooler" string
# (port 6543 or 5432 on the *.pooler.supabase.com host), not the "Direct
# connection" one (db.<ref>.supabase.co) -- that host is IPv6-only and
# fails outright from IPv4-only networks. This project uses the session
# pooler (port 5432) for both migrations and the running app, to avoid
# prepared-statement issues transaction-mode pooling has with Prisma's
# node-postgres driver adapter at any real concurrency.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# docker-compose.yml spins up a local Postgres as a fallback/offline dev
# option -- not used by DATABASE_URL above, but still valid if you want
# to point at it instead (postgresql://ncgb:ncgb_dev_password@localhost:5433/ncgb).
POSTGRES_USER=ncgb
POSTGRES_PASSWORD=ncgb_dev_password
POSTGRES_DB=ncgb
POSTGRES_PORT=5433

# Express server
PORT=4100
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000

# Phase 6+: JWT signing secret — generate a real random value, never reuse this.
# The admin API refuses to start with this placeholder left unchanged.
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Phase 6: seed the one admin user by running, once, with real values —
# never as committed defaults here:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='a-strong-password' npm run admin:seed

# Phase 4+: outbound email for lead/contact notifications
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFICATION_EMAIL_TO=natureculturegb@gmail.com

# Phase 7: AviationStack (https://aviationstack.com) for ISB<->KDU flight
# status. Free-tier key -- sign up for one, it's not committed here.
# Without this set, /flights reports every route as unavailable rather
# than failing; see backend/src/jobs/refreshFlights.ts for why this is
# only ever called by a once-daily scheduled job, never per-request.
AVIATIONSTACK_API_KEY=
