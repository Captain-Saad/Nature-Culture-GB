# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection used by Prisma. Matches docker-compose.yml defaults —
# change the credentials there too if you change them here.
DATABASE_URL="postgresql://ncgb:ncgb_dev_password@localhost:5433/ncgb?schema=public"

# docker-compose.yml reads these (falls back to the values above if unset)
POSTGRES_USER=ncgb
POSTGRES_PASSWORD=ncgb_dev_password
POSTGRES_DB=ncgb
POSTGRES_PORT=5433

# Express server
PORT=4100
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000

# Phase 6+: JWT signing secret — generate a real random value, never reuse this.
# The admin API refuses to start with this placeholder left unchanged.
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Phase 6: seed the one admin user by running, once, with real values —
# never as committed defaults here:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='a-strong-password' npm run admin:seed

# Phase 4+: outbound email for lead/contact notifications
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFICATION_EMAIL_TO=natureculturegb@gmail.com
